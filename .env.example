# Copia queste righe nella scheda "Environment" del progetto Compose in Dokploy.

# Download contemporanei di StudyCut
STUDYCUT_PARALLEL=3

# 1 = aggiorna yt-dlp all'avvio e ogni 24 ore (consigliato), 0 = mai
YTDLP_AUTO_UPDATE=1

# ---- trascrizione (StudyCut)
# Correzione incrociata audio + video: ogni frase viene confrontata con la lavagna e le slide,
# le formule dette a voce diventano LaTeX controllato con KaTeX. Senza chiave resta Whisper + parole lette dai fotogrammi.
ANTHROPIC_API_KEY=
# Modello (vuoto = claude-sonnet-5-5). In alternativa un'API compatibile OpenAI con immagini (es. Ollama):
STUDYCUT_LLM_MODEL=
STUDYCUT_LLM_URL=
STUDYCUT_LLM_KEY=

# ---- account
# Spazio per utente in GB, uguale per tutti i tool
USER_QUOTA_GB=2
# open = chiunque può registrarsi · closed = utenti creati solo da terminale
SIGNUP=open
# Se impostato, per registrarsi serve questo codice di invito
SIGNUP_CODE=
# Durata della sessione in giorni
SESSION_DAYS=30
