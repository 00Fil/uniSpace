# Gateway StudyKit. HTTPS e certificati li gestisce Traefik (Dokploy):
# qui si parla solo HTTP sulla porta 80, dentro la rete Docker.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# account: pagina di accesso, registrazione e sessioni (l'unica parte pubblica)
	handle /account/* {
		reverse_proxy account:8000 {
			header_up X-Client-IP {client_ip}
		}
	}
	redir /account /account/login 302

	# tutto il resto (home e tool) richiede l'accesso. Il servizio account conferma la sessione
	# e passa ai tool chi e' l'utente: X-User-Id (cartella personale), X-User-Name, X-User-Quota.
	# "route" mantiene l'ordine scritto: prima si controlla l'accesso, poi si serve la pagina.
	handle {
		route {
			# mai fidarsi di questi header se arrivano dal browser
			request_header -X-User-Id
			request_header -X-User-Name
			request_header -X-User-Quota
			forward_auth account:8000 {
				uri /auth/verify
				copy_headers X-User-Id X-User-Name X-User-Quota
			}

			# una rotta per ogni tool, generate da tools/*/tool.json
			import /etc/caddy/routes/*.caddy

			handle /tools.json {
				header Cache-Control "private, no-cache"
				root * /srv/home
				file_server
			}

			handle {
				# il browser ricontrolla sempre (e quindi ripassa dal controllo dell'accesso)
				header Cache-Control "private, no-cache"
				root * /srv/home
				file_server
			}
		}
	}

	log {
		output stdout
		format console
	}
}
