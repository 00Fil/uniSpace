# Gateway StudyKit. HTTPS e certificati li gestisce Traefik (Dokploy):
# qui si parla solo HTTP sulla porta 80, dentro la rete Docker.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

# Controllo dell'accesso, usato da ogni rotta dei tool (vedi scripts/build-registry.mjs).
# Il servizio account conferma la sessione e passa al tool chi e' l'utente:
# X-User-Id (cartella personale), X-User-Name, X-User-Quota. Senza sessione: pagina di accesso.
# "route" mantiene l'ordine scritto: prima si tolgono gli header falsi, poi si controlla.
(login) {
	route {
		# mai fidarsi di questi header se arrivano dal browser
		request_header -X-User-Id
		request_header -X-User-Name
		request_header -X-User-Quota
		forward_auth account:8000 {
			uri /auth/verify
			# indirizzo completo (con /nome-tool/) per tornare qui dopo l'accesso
			header_up X-Forwarded-Uri {http.request.orig_uri}
			copy_headers X-User-Id X-User-Name X-User-Quota
		}
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# account: accesso, registrazione, profilo e sessioni
	handle /account/* {
		reverse_proxy account:8000 {
			header_up X-Client-IP {client_ip}
		}
	}
	redir /account /account/ 308

	# una rotta per ogni tool, generate da tools/*/tool.json: richiedono l'accesso (import login)
	import /etc/caddy/routes/*.caddy

	# la home e l'elenco dei tool sono pubblici
	handle /tools.json {
		header Cache-Control "no-cache"
		root * /srv/home
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		root * /srv/home
		file_server
	}

	log {
		output stdout
		format console
	}
}
