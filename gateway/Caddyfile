# Gateway StudyKit. HTTPS e certificati li gestisce Traefik (Dokploy):
# qui si parla solo HTTP sulla porta 80, dentro la rete Docker.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

import /etc/caddy/auth.caddy

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# una rotta per ogni tool, generate da tools/*/tool.json
	import /etc/caddy/routes/*.caddy

	handle /tools.json {
		header Cache-Control "no-cache"
		root * /srv/home
		file_server
	}

	handle {
		root * /srv/home
		file_server
	}

	log {
		output stdout
		format console
	}
}
